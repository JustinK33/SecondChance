# SecondChance - example environment.
# Copy to backend/.env (backend vars) and frontend/.env.local (NEXT_PUBLIC_* + API url).
# Every value here is a placeholder. Never commit a real secret.

# ---- app ----
APP_ENV=local                              # local | staging | production; gates debug behaviour
LOG_LEVEL=INFO                             # DEBUG | INFO | WARNING | ERROR; structlog level
AUTH_MODE=dev                              # dev = trusted stub user, supabase = verify Supabase JWTs

# ---- database ----
# Local Docker Postgres from docker-compose.yml. Host port is 5433, not 5432.
DATABASE_URL=postgresql://secondchance:secondchance@localhost:5433/secondchance
TEST_DATABASE_URL=postgresql://secondchance:secondchance@localhost:5433/secondchance_test

# ---- langgraph ----
CHECKPOINTER=postgres                      # postgres = AsyncPostgresSaver, memory = InMemorySaver (tests)

# ---- gemini ----
GEMINI_API_KEY=your-gemini-api-key-here    # https://aistudio.google.com/apikey; never commit the real key
GEMINI_MODEL=gemini-2.5-flash-lite         # default model; the per-stage vars below override it
GEMINI_MODEL_EXTRACTION=gemini-2.5-flash-lite   # narrative -> structured profile, needs strict JSON
GEMINI_MODEL_EXPLANATION=gemini-2.5-flash-lite  # plain-language wording for an already-decided status
GEMINI_MODEL_CHAT=gemini-2.5-flash-lite         # follow-up conversation turns
GEMINI_TIMEOUT_S=30                        # per-request wall clock budget in seconds
GEMINI_MAX_RETRIES=3                       # retries for 5xx and 429 only
GEMINI_PRICE_INPUT_PER_MTOK=0.10           # USD per 1M input tokens, for cost telemetry
GEMINI_PRICE_OUTPUT_PER_MTOK=0.40          # USD per 1M output tokens, for cost telemetry

# ---- workflow ----
WORKFLOW_TIMEOUT_S=120                     # hard ceiling for one graph run
MAX_CONCURRENT_WORKFLOWS=8                 # semaphore guarding concurrent graph runs

# ---- supabase (server side) ----
SUPABASE_URL=https://your-project.supabase.co        # project REST/auth base url
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key      # server only, bypasses RLS, never expose
SUPABASE_JWT_SECRET=your-jwt-secret                  # verifies access tokens when AUTH_MODE=supabase

# ---- urls ----
FRONTEND_URL=http://localhost:3000         # allowed CORS origin for the API
NEXT_PUBLIC_API_URL=http://localhost:8000  # backend base url the browser calls

# ---- supabase (browser, public) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co   # same as SUPABASE_URL, safe to expose
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key                 # anon key, RLS enforced, safe to expose
